// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

enum OrderStatus {
  PENDING
  CONFIRMED
  PAID
  CANCELLED
}

enum UserStatus {
  USER
  ADMIN
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String
  name      String?
  createdAt DateTime   @default(now())
  status    UserStatus @default(USER)

  orders Order[]
  plans  PlannerItem[]

  @@map("user")
}

model Product {
  id   Int    @id @default(autoincrement())
  name String
  slug String @unique

  description String   @db.Text
  price       Decimal  @db.Decimal(10, 2)
  imageUrl    String?
  location    String?
  latitude    Float? // Szerokość geograficzna (GPS)
  longitude   Float? // Długość geograficzna (GPS)
  createdAt   DateTime @default(now())
  categoryId  Int?

  category    Category?     @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  planItems   PlannerItem[]
  routePoints RoutePoint[]

  @@index([categoryId])
  @@map("product")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("category")
}

model RoutePoint {
  id         Int     @id @default(autoincrement())
  productId  Int
  latitude   Float
  longitude  Float
  stopOrder  Int // Kolejność punktu na trasie (np. 1, 2, 3...)
  title      String? // Opcjonalna nazwa przystanku (np. "Wielki Kanion")
  categoryId Int?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("routepoint")
}

model Order {
  id            Int         @id @default(autoincrement())
  userId        Int?
  totalAmount   Decimal     @db.Decimal(10, 2)
  status        OrderStatus @default(PENDING)
  createdAt     DateTime    @default(now())
  customerName  String
  customerEmail String
  customerPhone Int

  user  User?       @relation(fields: [userId], references: [id])
  items OrderItem[]

  @@index([userId])
  @@map("order")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  productId Int
  quantity  Int     @default(1)
  price     Decimal @db.Decimal(10, 2)

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("orderitem")
}

model PlannerItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  productId Int
  addedAt   DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@index([userId])
  @@index([productId])
  @@map("planneritem")
}
